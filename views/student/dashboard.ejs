<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/navbar') %>

  <div class="dash-shell">
    <%- include('../partials/student-sidebar') %>

    <div class="dash-main">
      <h1 style="font-size:1.7rem;">My learning</h1>
      <p class="text-muted">Pick up where you left off, or browse the catalog for something new.</p>

      <div class="stat-grid">
        <div class="card stat-card">
          <div class="stat-num mono"><%= enrollments.length %></div>
          <div class="stat-label">Enrolled courses</div>
        </div>
        <div class="card stat-card">
          <div class="stat-num mono" style="color:var(--indigo);"><%= inProgress %></div>
          <div class="stat-label">In progress</div>
        </div>
        <div class="card stat-card">
          <div class="stat-num mono" style="color:var(--teal);"><%= completed %></div>
          <div class="stat-label">Completed</div>
        </div>
      </div>

      <% if (enrollments.length === 0) { %>
        <div class="empty-state card">
          <h3>You haven't enrolled in any courses yet</h3>
          <p>Browse the catalog and enroll in your first course.</p>
          <a href="/courses" class="btn btn-primary" style="margin-top:10px;">Browse courses</a>
        </div>
      <% } else { %>
        <div class="grid grid-2">
          <% enrollments.forEach(c => { %>
            <a href="/student/courses/<%= c.id %>" class="card course-card">
              <div class="course-cover" style="background: linear-gradient(135deg, <%= c.cover_color %>, #0A0F24);">
                <span class="badge badge-gold"><%= c.category %></span>
              </div>
              <div class="course-card-body">
                <div class="course-card-title"><%= c.title %></div>
                <div class="progress-track"><div class="progress-fill" style="width:<%= c.progress %>%;"></div></div>
                <div class="flex justify-between">
                  <span class="text-faint" style="font-size:0.8rem;"><%= c.progress %>% complete</span>
                  <% if (c.progress === 100) { %><span class="badge badge-teal">Certificate ready</span><% } %>
                </div>
                <% if (c.latestQuizAttempt) { %>
                  <div class="text-faint" style="font-size:0.8rem;margin-top:8px;">Latest quiz: <%= c.latestQuizAttempt.score %>/<%= c.latestQuizAttempt.total %></div>
                <% } %>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
